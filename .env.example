APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_s3vtgroup
DB_USERNAME=root
DB_PASSWORD=

# Optional: API key for sync endpoints (PHP site). If set, sync routes require X-API-Key header.
# SYNC_API_KEY=

# Smart inventory: default low-stock threshold (products with qty ≤ this trigger alerts)
# INVENTORY_LOW_STOCK_THRESHOLD=5

# Smart inventory: email for low-stock alerts (daily at 8:00). Requires MAIL_* configured.
# INVENTORY_ALERT_EMAIL=owner@example.com

# Telegram bot alerts (free): Create bot via @BotFather, get token. Message the bot then
# visit https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat_id.
# TELEGRAM_BOT_TOKEN=123456:ABC-def...
# TELEGRAM_CHAT_ID=123456789

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail / Google Workspace (G Suite) SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@s3vtgroup.com.kh
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-email@s3vtgroup.com.kh"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
